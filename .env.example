# Copy this file to .env. Nothing in here is required to run the app.
#
# Every request goes to Ollama on this machine, which needs no key and no account.
# Set this only if Ollama answers somewhere other than the default below.
# VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
#
# What has to exist is the models: `ollama pull gemma4:e4b` for the pages and the
# chat, `ollama pull embeddinggemma` for the notebook's retrieval index. Which ids
# are used is config/settings.json, and Presets changes them while the app runs.

# Backups of the local file database (./data), pushed to your own server over SSH.
# Leave these out and nothing backs up; see scripts/backup.sh for the commands.
# NL_BACKUP_HOST=user@your-box
# NL_BACKUP_PATH=/srv/nuclear-learning
# NL_BACKUP_PORT=22
# A Hetzner Storage Box answers SSH on port 23 and its home is /home, so it is
# NL_BACKUP_HOST=uXXXXXX@uXXXXXX.your-storagebox.de with PORT=23 and PATH=/home/...
# NL_BACKUP_SSH_KEY=~/.ssh/id_ed25519
# NL_BACKUP_KEEP=30
# Minutes between automatic pushes while the dev server runs; 0 or unset = manual.
# NL_BACKUP_EVERY_MIN=30
