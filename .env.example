# Copy this file to .env and fill in your OpenAI API key.
#
# This key is read by the browser and sent directly to the OpenAI API, so it is
# visible to anyone who can open the page. Run this locally only, and use a key
# you are able to rotate.
VITE_OPENAI_API_KEY=sk-...

# Backups of the local file database (./data), pushed to your own server over SSH.
# Leave these out and nothing backs up; see scripts/backup.sh for the commands.
# NL_BACKUP_HOST=user@your-box
# NL_BACKUP_PATH=/srv/nuclear-learning
# NL_BACKUP_PORT=22
# A Hetzner Storage Box answers SSH on port 23 and its home is /home, so it is
# NL_BACKUP_HOST=uXXXXXX@uXXXXXX.your-storagebox.de with PORT=23 and PATH=/home/...
# NL_BACKUP_SSH_KEY=~/.ssh/id_ed25519
# NL_BACKUP_KEEP=30
# Minutes between automatic pushes while the dev server runs; 0 or unset = manual.
# NL_BACKUP_EVERY_MIN=30
